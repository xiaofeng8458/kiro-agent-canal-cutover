# 复制为 env.sh 并填写（cp env.sh.sample env.sh），env.sh 含环境信息与密码，已被 gitignore。
# 密码一律不写在本文件：DB 密码用 MYSQL_PWD 环境变量或交互输入。

# --- Kubernetes ---
export NS="common-service"                 # canal 所在 namespace
export CANAL_POD="canal-server-0"
export ZK_NS=""                            # zk 所在 namespace（待填）
export ZK_POD=""                           # zk pod 名（待填）

# --- Canal ---
export DESTINATION="biz_v2_new"
export CLIENT_ID="1001"                    # Server->MQ 模式固定 1001
export ZK_CHROOT=""                        # canal.zkServers 端口后的路径前缀，无则留空
export CURSOR_PATH="${ZK_CHROOT}/otter/canal/destinations/${DESTINATION}/${CLIENT_ID}/cursor"

# --- Canal Admin ---
export ADMIN_API=""                        # 例 http://canal-admin.common-service:8089（待填）
export ADMIN_USER="admin"
# ADMIN_PASSWD 交互输入或从 secret 注入

# --- 数据库 ---
export MGR_DB_HOST=""                      # canal_manager 库地址（待填）
export MGR_DB_USER=""
export GREEN_RO_HOST=""                    # 绿环境只读副本地址（切换后即 RO 域名）
export GREEN_RO_USER=""

# --- 运行 ---
export STATE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/state/run_$(date +%Y%m%d)"

# --- 造数与端到端验证（40/50/51 号脚本） ---
export BIZ_DB_HOST=""                      # 业务库地址，留空则用 MGR_DB_HOST
export BIZ_DB_USER=""                      # 留空则用 MGR_DB_USER
export MARKER_TABLE="biz_test.marker"      # marker 测试表（库.表）
export KAFKA_BROKERS=""                    # Kafka bootstrap（待填）
export KAFKA_TOPIC="biz_test"              # canal 投递的 topic
